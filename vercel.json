{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/inquiry-digest",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/share"
    }
  ]
}